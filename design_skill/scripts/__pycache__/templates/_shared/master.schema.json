{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "設計主表 (work/<システム名>/master.json)",
  "description": "1システムにつき1つ。4種の設計書はここに定義された ID・名称だけを使う。IDは追記のみ（既存IDの改番・流用禁止）。相互参照の整合性は scripts/trace.py が検査する。",
  "type": "object",
  "required": [
    "system",
    "note_snapshot",
    "glossary",
    "assumptions",
    "requirements",
    "functions",
    "screens",
    "interfaces",
    "tables",
    "messages",
    "initial_data"
  ],
  "additionalProperties": false,
  "definitions": {
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "properties": {
    "system": {
      "type": "object",
      "required": [
        "name",
        "overview",
        "tech_stack"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "システム名。work/ と出力先のフォルダ名にもなる"
        },
        "overview": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "tech_stack": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "例: ['Next.js (TypeScript)', 'SQLite3']"
        }
      }
    },
    "note_snapshot": {
      "type": "string",
      "description": "主表を作成/更新した時点の note.txt 全文。note.txt の変更検知に使う"
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "note.txt に無く設計上決めた前提。全文書の _notes_for_review の元になる"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "category",
          "priority"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "enum": [
              "機能",
              "性能",
              "可用性",
              "運用",
              "セキュリティ",
              "保守性・拡張性"
            ]
          },
          "priority": {
            "enum": [
              "高",
              "中",
              "低"
            ]
          }
        }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "requirements"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "description": "「〜機能」で終わる。基本設計書・詳細仕様書のファイル名になる"
          },
          "description": {
            "type": "string"
          },
          "requirements": {
            "$ref": "#/definitions/refs",
            "minItems": 1,
            "description": "この機能が実現する REQ-xxx"
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "functions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SCR-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "description": "「〜画面」で終わる。詳細設計書のファイル名になる"
          },
          "description": {
            "type": "string"
          },
          "functions": {
            "$ref": "#/definitions/refs",
            "minItems": 1
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "method",
          "path",
          "screen",
          "functions",
          "auth"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IF-[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "description": "例: GET / POST / Server Action"
          },
          "path": {
            "type": "string",
            "description": "例: /api/nodes/{id}"
          },
          "screen": {
            "type": [
              "string",
              "null"
            ],
            "description": "呼び出し元の SCR-xx。画面を持たない IF は null"
          },
          "functions": {
            "$ref": "#/definitions/refs",
            "minItems": 1
          },
          "auth": {
            "type": "boolean",
            "description": "ログイン（認証）が必要な IF なら true。true の IF は IF定義書のエラーレスポンスに 401 行が必須"
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "columns",
          "functions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TBL-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "description": "物理名。例: nodes"
          },
          "description": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "functions": {
            "$ref": "#/definitions/refs",
            "minItems": 1
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "text",
          "functions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MSG-[0-9]{3}$"
          },
          "level": {
            "enum": [
              "エラー",
              "警告",
              "情報"
            ]
          },
          "text": {
            "type": "string"
          },
          "functions": {
            "$ref": "#/definitions/refs",
            "minItems": 1
          }
        }
      }
    },
    "initial_data": {
      "type": "array",
      "description": "システム稼働時に最初から入っているデータ（ログイン用ユーザー、ルートノード、コードマスタ等）。認証が必要な IF があるシステムでは、ログインに使う初期ユーザーを必ず含める。コード生成とテストはこの定義どおりに初期データを作る",
      "items": {
        "type": "object",
        "required": [
          "table",
          "description",
          "rows"
        ],
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^TBL-[0-9]{2}$"
          },
          "description": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "1行 = 1レコード。列名=値 を読点区切りで書く（パスワードは平文を書き、保存時にハッシュ化する旨を description に書く）"
          }
        }
      }
    }
  }
}
